# ──────────────────────────────────────────────
# Fact & Claim Verifier — Environment Variables
# Copy to .env and fill in your values.
# Leave LLM/search keys blank to run in mock mode.
# ──────────────────────────────────────────────

# LLM Provider
# Provide ONE of the following:
OPENAI_API_KEY=                      # OpenAI GPT-4o
OPENAI_MODEL=gpt-4o
# GOOGLE_GEMINI_KEY=                 # Alternative: Google Gemini

# Search Provider
SERPAPI_KEY=                         # SerpAPI (https://serpapi.com)
# GOOGLE_CSE_API_KEY=                # Alternative: Google Custom Search
# GOOGLE_CSE_CX=                     # Custom Search Engine ID
# TAVILY_API_KEY=                    # Alternative: Tavily

# Caching (optional)
REDIS_URL=redis://localhost:6379/0

# Vector Index (optional)
FAISS_INDEX_PATH=./data/faiss_index

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Additional search providers (optional) ────────────────────────────────────
TAVILY_API_KEY=                      # Alternative to SerpAPI (https://tavily.com)
                                     # Free tier: 1000 searches/month
# DuckDuckGo is always available as a free fallback — no key needed
